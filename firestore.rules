rules_version = '2';

// Gen Worlds. The web config is public, so these rules are the only access control.
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // A co-op room: any signed-in player who knows the code may read and change it.
    // The code is the secret; rooms hold no personal data beyond a display name.
    match /rooms/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.version == 1
        && request.resource.data.code == code;
      allow update: if request.auth != null
        && request.resource.data.version == 1
        && request.resource.data.code == code
        && request.resource.data.players.size() <= 8
        && request.resource.data.requests.size() <= 60;
      allow delete: if false;
    }

    // Leaderboard entries: written once, never changed. Every client re-simulates an entry from its
    // design, seed and input log before showing it, so a forged score is simply not displayed.
    match /scores/{entry} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is number
        && request.resource.data.seed is number
        && request.resource.data.scenario is string
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 4000;
      allow update, delete: if false;
    }
  }
}
