# Template only. Never put real values in this file: it is committed.
#
# Where real values go (all gitignored):
#
#   .env.local     PUBLIC client config. Anything prefixed VITE_ is compiled into the
#                  JavaScript bundle and visible to every visitor. Only values that are
#                  safe to publish belong here (the Firebase web config is one: access is
#                  controlled by database rules, not by hiding the config).
#
#   .env.secrets   REAL secrets for build-time tools that run in Docker (data snapshots).
#                  Never prefix these with VITE_. They never reach the browser.
#
#   secrets/       Secret files (service-account JSON, certificates).
#
# For the GitHub Pages build the same values are set in the repository settings:
#   Settings -> Secrets and variables -> Actions
#     "Variables" tab: the VITE_* values below
#     "Secrets" tab:   the .env.secrets values below
#
# Setup: copy the two blocks into the files named above and fill them in.
# The game runs without any of them (offline co-op, local leaderboard).

# ---- .env.local (public client config) ------------------------------------
# Firebase console -> Project settings -> Your apps -> Web app -> SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- .env.secrets (never VITE_, never in the browser) ---------------------
# Meteomatics API (optional, launch-weather snapshot at build time)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
# NASA API key from api.nasa.gov (optional; DEMO_KEY works at low rate limits)
NASA_API_KEY=
